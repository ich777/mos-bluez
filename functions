#!/bin/bash

# Import MOS functions
. /usr/local/lib/functions/mos-common

# Set variables for plugin
PLG_NAME="bluez"
DISPLAY_NAME="BlueZ"
PLG_DIR="/boot/optional/plugins/$PLG_NAME"
PKG_DIR="$PLG_DIR/packages"
PACKAGES="dbus bluez"
COMMAND="/usr/bin/plugins/bluez"

# apt options to fail fast without network
APT_OPTS="-o Acquire::Retries=1 -o Acquire::http::Timeout=10 -o Acquire::https::Timeout=10 -o Acquire::ftp::Timeout=10"

# Keep only the newest .deb per package
cleanup_old_debs() {
  local deb base
  for deb in "$PKG_DIR"/*.deb ; do
    [ -e "$deb" ] || continue
    base="${deb##*/}"
    base="${base%%_*}"
    ls -1 "$PKG_DIR/${base}_"*.deb 2>/dev/null | sort -V | head -n -1 | while read -r old ; do
      rm -f "$old"
    done
  done
}

# Update lists and download packages into the boot cache
refresh_cache() {
  mkdir -p "$PKG_DIR/partial"
  DEBIAN_FRONTEND=noninteractive apt-get.orig $APT_OPTS update >/dev/null 2>&1 || return 1
  DEBIAN_FRONTEND=noninteractive apt-get.orig $APT_OPTS install -y --download-only --no-install-recommends \
    -o Dir::Cache::archives="$PKG_DIR" $PACKAGES >/dev/null 2>&1 || return 1
  cleanup_old_debs
  return 0
}

# Make sure the messagebus user/group exists
ensure_users() {
  if ! getent group messagebus >/dev/null 2>&1 ; then
    groupadd --system messagebus 2>/dev/null || addgroup --system messagebus 2>/dev/null
  fi
  if ! getent passwd messagebus >/dev/null 2>&1 ; then
    useradd --system --gid messagebus --home-dir /nonexistent --shell /usr/sbin/nologin messagebus 2>/dev/null || \
      adduser --system --no-create-home --ingroup messagebus --home /nonexistent --shell /usr/sbin/nologin messagebus 2>/dev/null
  fi
}

# Install all cached packages
install_from_cache() {
  ls "$PKG_DIR"/*.deb >/dev/null 2>&1 || return 1
  ensure_users
  DEBIAN_FRONTEND=noninteractive dpkg -i "$PKG_DIR"/*.deb >/dev/null 2>&1
  DEBIAN_FRONTEND=noninteractive dpkg --configure -a >/dev/null 2>&1
  packages_installed
}

# Check if dbus and bluez are installed
packages_installed() {
  dpkg-query -W -f='${Status}' dbus 2>/dev/null | grep -q "install ok installed" && \
    dpkg-query -W -f='${Status}' bluez 2>/dev/null | grep -q "install ok installed"
}

install() {
  echo "Installing dbus and bluez..."
  mkdir -p "$PKG_DIR"

  if ! refresh_cache ; then
    echo "Failed to download packages"
    exit 1
  fi

  if ! install_from_cache ; then
    echo "Failed to install packages"
    exit 1
  fi

  echo "dbus and bluez installed"
  "$COMMAND" start
}

mos_start() {
  mkdir -p "$PKG_DIR"

  if ls "$PKG_DIR"/*.deb >/dev/null 2>&1 ; then
    # Install from cache, refresh in background for next boot
    install_from_cache
    ( refresh_cache && install_from_cache ) >/dev/null 2>&1 &
  else
    # No cache yet, fetch now
    if refresh_cache ; then
      install_from_cache
    else
      echo "No cached packages and no network, skipping start"
      return 0
    fi
  fi

  if packages_installed ; then
    "$COMMAND" start
  else
    echo "dbus/bluez not installed, skipping start"
  fi
}
